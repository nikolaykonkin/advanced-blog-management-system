# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blog_db
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Deferred action log (channel + worker goroutine, see pkg/logger)
ACTION_LOG_PATH=log.txt

# Environment
ENV=development
